# Local desktop-app setup: SQLite file next to the backend, no server/domain needed.
DATABASE_URL=sqlite:///./bemas_muhasebe.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Seed admin - set your own values here, this file is just a template
SEED_ADMIN_USERNAME=change-me
SEED_ADMIN_PASSWORD=change-me

# Path the desktop app's embedded UI is served under (local only, e.g. http://localhost:8000/adminpanel/)
ADMIN_PANEL_BASE_PATH=/adminpanel

# Optional: path to tesseract binary if not on PATH (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
